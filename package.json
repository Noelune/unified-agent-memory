{
  "name": "dsh-unified-agent-memory",
  "version": "0.2.0",
  "description": "Unified agent memory for DeepSeek Harness — one shared Obsidian vault for every agent (dsh, Codex, Claude, Hermes). Ships the dependency-free Python core (search/promote/adjudicate/forget), a vault template, and a dsh plugin with memory_search / memory_show / memory_submit / memory_status tools. · 统一 Agent 记忆系统：多 Agent 共享一个 Obsidian vault，附零依赖 Python core 与 dsh 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client-ui.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs/AGENT-DEPLOY.md",
    "cordis.patch.yml",
    "README.md",
    "core/pyproject.toml",
    "core/README.md",
    "core/unified_memory/*.py"
  ],
  "scripts": {
    "test": "python -m unittest discover -s core/tests"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "obsidian",
    "multi-agent",
    "knowledge-base"
  ],
  "author": "Noelune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noelune/unified-agent-memory.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
