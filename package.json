{
  "name": "dsh-unified-agent-memory",
  "version": "0.5.1",
  "description": "Unified agent memory for DeepSeek Harness — one shared Obsidian vault for every agent (dsh, Codex, Claude, Hermes). Ships the dependency-free Python core (search/promote/adjudicate/forget), a vault template, and a dsh plugin with memory_search / memory_show / memory_submit / memory_status tools. · 统一 Agent 记忆系统：多 Agent 共享一个 Obsidian vault，附零依赖 Python core 与 dsh 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client-ui.js",
      "default": "./lib/client-ui.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "integrations/hermes/*.py",
    "integrations/hermes/README.md",
    "vault-template",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "core/pyproject.toml",
    "core/README.md",
    "core/unified_memory/*.py"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "drift:check": "node scripts/drift-check.mjs",
    "drift:python": "node scripts/drift-python.mjs",
    "sync:check": "node scripts/sync-check.mjs",
    "setup-hooks": "node scripts/install-hooks.mjs",
    "test": "python -m unittest discover -s core/tests",
    "test:js": "vitest run",
    "check": "npm run typecheck && npm run drift:check && npm run sync:check && npm run test:js && npm run test && npm run build && npm run drift:python"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@types/node": "^24.13.4",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "compatibility": {
      "node": ">=20",
      "dshReleases": {
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "obsidian",
    "multi-agent",
    "knowledge-base"
  ],
  "author": "Noelune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noelune/unified-agent-memory.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
