# Secrets — never commit
*.secret
.env
.env.*

# Runtime data
logs/
sessions/
*.bak*
*.tmp
*.log

# Local user config & index (never commit YOUR vault config)
.unified-memory.yaml
index.db
promote.log

# Probe/tooling files
.dsh-*
.idea/
.vscode/
*.swp

# Node
node_modules/
*.tgz

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
build/
dist/

# OS
Thumbs.db
.DS_Store

# Extra excludes for the npm package
# core/tests/ is deliberately NOT excluded: the suite is stdlib-only and
# ~700 KB, and shipping it is what makes "installed, therefore unverifiable"
# avoidable — `python -m unittest discover -s core/tests` works from the
# installed package with no clone and no dev dependencies.
src/
test/
scripts/
build.mjs
tsconfig.json
vitest.config.ts
